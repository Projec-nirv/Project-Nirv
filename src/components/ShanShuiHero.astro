---
interface Props {
  caption?: string
  initialSeed?: string
}

const {
  caption = 'FIG. 01 / SYSTEMS IN MOTION',
  initialSeed = 'nirv-terrain-01'
} = Astro.props
---

<div class="shanshui-container" data-initial-seed={initialSeed}>
  <div class="shanshui-meta">
    <div class="meta-item">
      <span class="crosshair-icon">+</span>
      <span class="meta-caption">{caption}</span>
    </div>
    <div class="meta-item meta-readout">
      <span class="meta-coord" id="shanshui-coord">COORD: X+0000</span>
      <span class="meta-divider">|</span>
      <span class="meta-seed" id="shanshui-seed">SEED: #{initialSeed.slice(0, 8)}</span>
    </div>
  </div>

  <div class="shanshui-viewport" id="shanshui-viewport">
    <!-- Static fallback shown until the SVG is ready -->
    <img
      id="shanshui-fallback"
      class="shanshui-fallback"
      src="/static/nirv-landscape-ink.webp"
      alt="Survey landscape of layered mountains"
      width="1774"
      height="887"
      fetchpriority="high"
    />
    <!-- Live SVG injected once on load -->
    <div id="shanshui-svg-wrapper" class="shanshui-svg-wrapper" aria-hidden="true"></div>

    <div id="shanshui-status" class="shanshui-status">
      <span class="status-pulse"></span>
      <span class="status-text">RENDERING TERRAIN…</span>
    </div>

    <div class="shanshui-drag-hint" id="shanshui-drag-hint">
      <span>↔ DRAG TO PAN</span>
    </div>
  </div>

  <div class="shanshui-toolbar">
    <div class="toolbar-group">
      <button type="button" class="shanshui-btn" id="btn-pan-left">← SCAN LEFT</button>
      <button type="button" class="shanshui-btn" id="btn-pan-right">SCAN RIGHT →</button>
    </div>
    <div class="toolbar-group">
      <button type="button" class="shanshui-btn" id="btn-export-svg">⭳ EXPORT .SVG</button>
    </div>
  </div>
</div>

<style>
  .shanshui-container {
    position: relative;
    width: 100%;
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    user-select: none;
  }

  .shanshui-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid var(--rule);
    font: 10px/1 var(--mono);
    letter-spacing: 0.14em;
    color: var(--muted-ink);
    background: rgba(241,238,229,0.6);
  }

  .meta-item { display: flex; align-items: center; gap: 8px; }
  .crosshair-icon { color: var(--accent); font-weight: 700; }
  .meta-caption { color: var(--ink); text-transform: uppercase; }
  .meta-readout { gap: 12px; }
  .meta-divider { color: var(--rule); }

  .shanshui-viewport {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
    cursor: grab;
    background: transparent;
  }
  .shanshui-viewport.is-dragging { cursor: grabbing; }

  .shanshui-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom center;
    mix-blend-mode: multiply;
    transition: opacity 0.7s ease;
    z-index: 1;
  }
  .shanshui-fallback.is-faded { opacity: 0; pointer-events: none; }

  /* The SVG layer is positioned absolutely and panned by translating the inner SVG via viewBox only */
  .shanshui-svg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.5s ease;
    overflow: hidden;
  }
  .shanshui-svg-wrapper.is-ready { opacity: 1; }
  .shanshui-svg-wrapper :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .shanshui-status {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 4px 10px;
    font: 9px var(--mono);
    letter-spacing: 0.15em;
    color: var(--muted-ink);
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.3s ease;
  }
  .shanshui-status.is-hidden { opacity: 0; transform: translateY(-4px); }

  @keyframes pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.85); }
    50%       { opacity: 1;   transform: scale(1.2); }
  }
  .status-pulse {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    animation: pulse 1.4s infinite ease-in-out;
  }

  .shanshui-drag-hint {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font: 9px var(--mono);
    letter-spacing: 0.16em;
    color: var(--muted-ink);
    background: rgba(241,238,229,0.85);
    border: 1px solid var(--rule);
    padding: 3px 10px;
    border-radius: 2px;
    pointer-events: none;
    backdrop-filter: blur(2px);
    transition: opacity 0.4s ease;
  }
  .shanshui-drag-hint.is-faded { opacity: 0; }

  .shanshui-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 12px;
    border-top: 1px solid var(--rule);
    background: rgba(241,238,229,0.6);
  }
  .toolbar-group { display: flex; gap: 6px; flex-wrap: wrap; }

  .shanshui-btn {
    appearance: none;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font: 10px/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 11px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s ease;
    border-radius: 1px;
  }
  .shanshui-btn:hover { background: #e7e4da; border-color: var(--ink); color: var(--accent); }
  .shanshui-btn:active { transform: translateY(1px); }

  @media (max-width: 700px) {
    .shanshui-viewport { height: 300px; }
    .meta-readout { display: none; }
  }
  @media (max-width: 460px) {
    .shanshui-viewport { height: 240px; }
  }
</style>

<script>
  import { ShanShui } from '@/lib/shan-shui'

  function initShanShuiHero() {
    const container = document.querySelector('.shanshui-container') as HTMLElement | null
    if (!container) return

    const seed = container.dataset.initialSeed ?? String(Date.now())
    const viewport      = document.getElementById('shanshui-viewport')      as HTMLElement | null
    const svgWrapper    = document.getElementById('shanshui-svg-wrapper')   as HTMLElement | null
    const fallback      = document.getElementById('shanshui-fallback')      as HTMLElement | null
    const statusBadge   = document.getElementById('shanshui-status')        as HTMLElement | null
    const dragHint      = document.getElementById('shanshui-drag-hint')     as HTMLElement | null
    const coordEl       = document.getElementById('shanshui-coord')         as HTMLElement | null
    const seedEl        = document.getElementById('shanshui-seed')          as HTMLElement | null
    const btnLeft       = document.getElementById('btn-pan-left')           as HTMLButtonElement | null
    const btnRight      = document.getElementById('btn-pan-right')          as HTMLButtonElement | null
    const btnExport     = document.getElementById('btn-export-svg')         as HTMLButtonElement | null

    if (!viewport || !svgWrapper) return

    // ── State ────────────────────────────────────────────────────────────────
    // totalWidth: full SVG coordinate width generated once
    const VIEWPORT_W  = 1600   // SVG coordinate width (wider than visible → pan room)
    const VIEWPORT_H  = 700
    const ZOOM        = 1.142
    // How many SVG units are visible at once
    const visibleW = VIEWPORT_W / ZOOM   // ≈1400

    let svgEl: SVGSVGElement | null = null
    // Store just the full SVG string so we can export it; chunks already freed.
    let fullSvgContent = ''
    let curX = 0                          // current pan position (SVG units)
    let maxX = 0                          // maximum pannable X (totalWidth - visibleW)
    let isDragging = false
    let lastClientX = 0
    let velocity = 0
    let rafId: number | null = null
    let interacted = false

    // ── Generate once ────────────────────────────────────────────────────────
    requestAnimationFrame(() => {
      // Defer off the paint frame so the static fallback renders first
      setTimeout(() => {
        const engine = new ShanShui({ seed, width: VIEWPORT_W, height: VIEWPORT_H, chunkWidth: 512 })
        fullSvgContent = engine.getVisibleSvgContent()

        // Free the heavy chunks array — it's a few MB and we're done with it
        engine.chunks = []
        maxX = Math.max(0, engine.xmax - visibleW)

        // Build the SVG element once
        svgWrapper.innerHTML = `
          <svg id="shanshui-live-svg"
               xmlns="http://www.w3.org/2000/svg"
               viewBox="0 0 ${VIEWPORT_W / ZOOM} ${VIEWPORT_H / ZOOM}"
               width="100%" height="100%"
               preserveAspectRatio="xMidYMid slice"
               style="mix-blend-mode:multiply;">
            <g>${fullSvgContent}</g>
          </svg>`
        svgEl = document.getElementById('shanshui-live-svg') as unknown as SVGSVGElement

        // Seed readout
        if (seedEl) seedEl.textContent = `SEED: #${seed.slice(0, 8)}`

        // Transition to live
        statusBadge?.classList.add('is-hidden')
        svgWrapper.classList.add('is-ready')
        setTimeout(() => fallback?.classList.add('is-faded'), 350)

        // Start slow ambient drift
        startDrift()
      }, 60)
    })

    // ── viewBox pan (no SVG re-generation ever) ───────────────────────────────
    function applyPan() {
      if (!svgEl) return
      curX = Math.max(0, Math.min(curX, maxX))
      svgEl.setAttribute('viewBox', `${curX} 0 ${VIEWPORT_W / ZOOM} ${VIEWPORT_H / ZOOM}`)
      if (coordEl) coordEl.textContent = `COORD: X+${Math.round(curX).toString().padStart(4, '0')}`
    }

    // ── Ambient drift ─────────────────────────────────────────────────────────
    const DRIFT_SPEED = 0.18  // SVG units per frame — very gentle

    function driftLoop() {
      if (!isDragging) {
        // Friction on user-thrown velocity
        if (Math.abs(velocity) > 0.01) {
          curX -= velocity
          velocity *= 0.91
          applyPan()
        } else {
          // Ambient drift — stop at the far edge then reverse
          if (curX >= maxX) {
            curX = maxX
          } else {
            curX += DRIFT_SPEED
            applyPan()
          }
        }
      }
      rafId = requestAnimationFrame(driftLoop)
    }

    function startDrift() {
      if (!rafId) rafId = requestAnimationFrame(driftLoop)
    }

    function stopDrift() {
      if (rafId) { cancelAnimationFrame(rafId); rafId = null }
    }

    // ── Drag ─────────────────────────────────────────────────────────────────
    function onDown(e: MouseEvent | TouchEvent) {
      isDragging = true
      velocity = 0
      lastClientX = 'touches' in e ? e.touches[0].clientX : e.clientX
      viewport?.classList.add('is-dragging')
      if (!interacted) {
        interacted = true
        dragHint?.classList.add('is-faded')
      }
    }

    function onMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return
      const cx = 'touches' in e ? e.touches[0].clientX : e.clientX
      const dx = cx - lastClientX
      lastClientX = cx
      // Convert screen pixels → SVG units (viewport px → SVG coordinate space)
      const svgScale = VIEWPORT_W / ZOOM / (viewport?.clientWidth ?? VIEWPORT_W)
      velocity = -dx * svgScale * 0.7
      curX -= dx * svgScale
      applyPan()
    }

    function onUp() {
      isDragging = false
      viewport?.classList.remove('is-dragging')
    }

    viewport.addEventListener('mousedown', onDown)
    window.addEventListener('mousemove', onMove)
    window.addEventListener('mouseup', onUp)
    viewport.addEventListener('touchstart', onDown, { passive: true })
    window.addEventListener('touchmove', onMove, { passive: true })
    window.addEventListener('touchend', onUp)

    // ── Buttons ───────────────────────────────────────────────────────────────
    btnLeft?.addEventListener('click', () => {
      velocity = 8
      if (!interacted) { interacted = true; dragHint?.classList.add('is-faded') }
    })
    btnRight?.addEventListener('click', () => {
      velocity = -8
      if (!interacted) { interacted = true; dragHint?.classList.add('is-faded') }
    })

    btnExport?.addEventListener('click', () => {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${VIEWPORT_W / ZOOM} ${VIEWPORT_H / ZOOM}" width="${Math.round(VIEWPORT_W / ZOOM)}" height="${Math.round(VIEWPORT_H / ZOOM)}" style="mix-blend-mode:multiply;"><g>${fullSvgContent}</g></svg>`
      const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' })
      const url  = URL.createObjectURL(blob)
      const a    = Object.assign(document.createElement('a'), { href: url, download: `shanshui-${seed}.svg` })
      document.body.appendChild(a)
      a.click()
      document.body.removeChild(a)
      URL.revokeObjectURL(url)
    })

    // Stop drift when page hides, restart on show — saves CPU in background tabs
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopDrift()
      else if (svgEl) startDrift()
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShanShuiHero)
  } else {
    initShanShuiHero()
  }
  document.addEventListener('astro:page-load', initShanShuiHero)
</script>

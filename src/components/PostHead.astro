---
import { SITE } from '@/consts'
import {
  generateBlogPostingSchema,
  generateArticleSchema,
  generateBreadcrumbSchema,
  generateOpenGraphMetadata,
  generateTwitterMetadata,
  generateSemanticMetadata,
} from '@/lib/semantic-metadata'
import { isSubpost } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

const title = post.data.title || SITE.title
const description = post.data.description || SITE.description
const author =
  post.data.authors && post.data.authors.length > 0
    ? post.data.authors.join(', ')
    : SITE.author

// Generate image URL
const imageUrl = post?.data?.image?.src ? `${SITE.href}${post.data.image.src}` : `${SITE.href}/static/1200x630.png`

// Generate semantic metadata
const semanticData = generateSemanticMetadata(post)

// Generate JSON-LD schemas
const blogPostingSchema = generateBlogPostingSchema(post, Astro.url, imageUrl)
const articleSchema = generateArticleSchema(post, Astro.url, imageUrl)

// Generate breadcrumb schema
const breadcrumbItems = [
  { name: 'Home', url: SITE.href },
  { name: 'Research', url: `${SITE.href}/blog` },
  { name: title, url: Astro.url.toString() },
]
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)

// Generate social metadata
const ogMetadata = generateOpenGraphMetadata(post, Astro.url, imageUrl)
const twitterMetadata = generateTwitterMetadata(post, imageUrl)

// Determine if indexable
const isCurrentSubpost = isSubpost(post.id)
---

<title>{`${title} | ${SITE.title}`}</title>

<!-- Primary Meta Tags -->
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
<meta name="keywords" content={post.data.tags?.join(', ') || ''} />
<meta name="author" content={author} />

<!-- Canonical URL -->
<link rel="canonical" href={Astro.url.toString()} />

<!-- Subpost Robots Control -->
{isCurrentSubpost && <meta name="robots" content="noindex, follow" />}

<!-- Semantic & Retrieval Tags -->
{
  semanticData.semanticTags.length > 0 && (
    <meta name="semantic-tags" content={semanticData.semanticTags.join(', ')} />
  )
}

<!-- Open Graph Tags - For LLM Context & Social Sharing -->
{Object.entries(ogMetadata).map(([key, value]) => (
  <meta property={key} content={value} />
))}

<!-- Twitter Card - AI Agent Compatibility -->
{Object.entries(twitterMetadata).map(([key, value]) => (
  <meta name={key} content={value} />
))}

<!-- JSON-LD Structured Data Schemas -->
<!-- BlogPosting Schema -->
<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} is:inline />

<!-- Article Schema -->
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />

<!-- Breadcrumb Schema for Navigation Understanding -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<!-- Article Metadata for AI Extraction -->
<meta name="article:published_time" content={post.data.date?.toISOString() || new Date().toISOString()} />
<meta name="article:author" content={author} />
<meta name="article:section" content="Research" />
{post.data.tags && <meta name="article:tag" content={post.data.tags.join(', ')} />}

<!-- AI-Specific Metadata -->
<meta name="ai:summary" content={description} />
<meta name="ai:tags" content={post.data.tags?.join(', ') || ''} />
<meta name="ai:topics" content={semanticData.semanticTags.join(', ')} />
<meta name="ai:retrieval-score" content={semanticData.entities.length.toString()} />

<!-- LLM Optimization -->
<meta name="llm-context" content="research-article" />
<meta name="llm-topics" content={post.data.tags?.join(', ') || ''} />
<meta name="llm-summary" content={description} />

<!-- Source Attribution for AI Systems -->
{
  post.data.sources && post.data.sources.length > 0 && (
    <meta
      name="sources"
      content={post.data.sources
        .map((s) => `${s.title}:${s.url}`)
        .join('; ')}
    />
  )
}

<!-- Machine-Readable Metadata for Search Engines & Agents -->
<meta name="format" content="research-article" />
<meta name="content-type" content="application/ld+json" />
<meta name="indexability" content={isCurrentSubpost ? 'subpost' : 'main'} />
<meta name="citation-title" content={title} />
<meta name="citation-author" content={author} />
<meta name="citation-publication-date" content={post.data.date?.toISOString() || new Date().toISOString()} />

<!-- Semantic HTML Enhancement -->
<meta property="article:content-type" content="long-form-research" />
<meta name="readability-score" content="high" />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}

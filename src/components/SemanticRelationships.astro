---
// Semantic Relationships Displayer Component
// Shows related articles and research continuations

import Link from '@/components/Link.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

// Extract all relationship data
const researchDomains = post.data.researchDomains || []
const relatedArticles = post.data.relatedArticles || []
const forecastContinuations = post.data.forecastContinuations || []

const formatLabel = (value: string) =>
  value
    .split('-')
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
---

<!-- Semantic Relationships Section -->
<aside class="mt-12 space-y-8">
  <!-- Research Domains -->
  {
    researchDomains.length > 0 && (
      <section class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
        <h3 class="mb-4 text-lg font-bold">Research Domains</h3>
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
          Broader research areas this article contributes to.
        </p>
        <div class="space-y-2">
          {researchDomains.map((domain) => (
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-900">
              <p class="font-medium text-gray-900 dark:text-gray-100">
                {domain}
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Related Articles -->
  {
    relatedArticles.length > 0 && (
      <section class="rounded-lg border border-gray-200 bg-gradient-to-br from-green-50 to-green-50/50 p-6 dark:border-gray-700 dark:from-green-900/20 dark:to-green-900/10">
        <h3 class="mb-4 text-lg font-bold">Related Research</h3>
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
          Other articles in Project NIRV's knowledge graph with semantic
          relationships.
        </p>
        <div class="space-y-4">
          {relatedArticles.map((rel) => (
            <div class="rounded-lg border border-green-200/50 bg-white p-4 dark:border-green-800/50 dark:bg-gray-900">
              <div class="mb-2 flex items-start justify-between gap-3">
                <Link
                  href={`/blog/${rel.articleId}`}
                  class="flex-1 font-semibold text-green-600 hover:underline dark:text-green-400"
                >
                  {rel.articleId}
                </Link>
                <span class="shrink-0 rounded bg-green-600 px-2 py-1 text-xs whitespace-nowrap text-white dark:bg-green-700">
                  {formatLabel(rel.relationship)}
                </span>
              </div>
              <p class="text-sm text-gray-700 dark:text-gray-300">
                {rel.reason}
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Forecast Continuations -->
  {
    forecastContinuations.length > 0 && (
      <section class="rounded-lg border border-gray-200 bg-gradient-to-br from-purple-50 to-purple-50/50 p-6 dark:border-gray-700 dark:from-purple-900/20 dark:to-purple-900/10">
        <h3 class="mb-4 text-lg font-bold">Future Research Directions</h3>
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
          Follow-up research topics identified by this analysis.
        </p>
        <div class="space-y-4">
          {forecastContinuations.map((continuation) => (
            <div class="rounded-lg border border-purple-200/50 bg-white p-4 dark:border-purple-800/50 dark:bg-gray-900">
              <p class="mb-2 font-semibold text-gray-900 dark:text-gray-100">
                {continuation.topic}
              </p>
              <p class="text-sm text-gray-700 italic dark:text-gray-300">
                {continuation.rationale}
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Knowledge Graph Metadata -->
  {
    (relatedArticles.length > 0 || forecastContinuations.length > 0) && (
      <section class="rounded-lg border border-gray-200 bg-gray-50 p-4 text-xs text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400">
        <p class="mb-2 font-medium">Machine-Readable Metadata</p>
        <p>
          This article is part of Project NIRV's interconnected semantic
          research graph. All related concepts and article relationships are
          exposed through structured data (JSON-LD and Schema.org schemas) for
          improved AI understanding and knowledge retrieval.
        </p>
      </section>
    )
  }
</aside>

---
// Semantic Relationships Displayer Component
// Shows related articles, canonical topics, and knowledge graph connections

import Link from '@/components/Link.astro'
import { getConceptById } from '@/lib/canonical-concepts'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

// Extract all relationship data
const canonicalTopics = post.data.canonicalTopics || []
const relatedConcepts = post.data.relatedConcepts || []
const researchDomains = post.data.researchDomains || []
const relatedArticles = post.data.relatedArticles || []
const forecastContinuations = post.data.forecastContinuations || []

// Map concept IDs to labels
const topicLabels = canonicalTopics.map((id) => ({
  id,
  label: getConceptById(id)?.label || id,
  slug: getConceptById(id)?.slug || id,
}))

const conceptLabels = relatedConcepts.map((id) => ({
  id,
  label: getConceptById(id)?.label || id,
  slug: getConceptById(id)?.slug || id,
}))
---

<!-- Semantic Relationships Section -->
<aside class="mt-12 space-y-8">
  <!-- Canonical Topics -->
  {
    topicLabels.length > 0 && (
      <section class="rounded-lg border border-gray-200 dark:border-gray-700 p-6 bg-gradient-to-br from-blue-50 to-blue-50/50 dark:from-blue-900/20 dark:to-blue-900/10">
        <h3 class="text-lg font-bold mb-4">Core Research Topics</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          This article defines or explores these canonical concepts within Project NIRV's research framework.
        </p>
        <div class="space-y-3">
          {topicLabels.map((topic) => (
            <div class="flex items-start gap-3 p-3 bg-white dark:bg-gray-900 rounded-lg border border-blue-200/50 dark:border-blue-800/50">
              <div class="flex-1 min-w-0">
                <Link href={`/concepts/${topic.slug}`} class="font-semibold text-blue-600 dark:text-blue-400 hover:underline">
                  {topic.label}
                </Link>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                  {getConceptById(topic.id)?.shortDescription}
                </p>
              </div>
              <span class="text-xs text-gray-500 px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded shrink-0 whitespace-nowrap">
                Canonical Topic
              </span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Related Concepts -->
  {
    conceptLabels.length > 0 && (
      <section class="rounded-lg border border-gray-200 dark:border-gray-700 p-6">
        <h3 class="text-lg font-bold mb-4">Related Concepts</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Additional concepts mentioned or referenced in this article.
        </p>
        <div class="flex flex-wrap gap-2">
          {conceptLabels.map((concept) => (
            <Link
              href={`/concepts/${concept.slug}`}
              class="px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700 transition"
            >
              {concept.label}
            </Link>
          ))}
        </div>
      </section>
    )
  }

  <!-- Research Domains -->
  {
    researchDomains.length > 0 && (
      <section class="rounded-lg border border-gray-200 dark:border-gray-700 p-6">
        <h3 class="text-lg font-bold mb-4">Research Domains</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Broader research areas this article contributes to.
        </p>
        <div class="space-y-2">
          {researchDomains.map((domain) => (
            <div class="p-3 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700">
              <p class="font-medium text-gray-900 dark:text-gray-100">{domain}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Related Articles -->
  {
    relatedArticles.length > 0 && (
      <section class="rounded-lg border border-gray-200 dark:border-gray-700 p-6 bg-gradient-to-br from-green-50 to-green-50/50 dark:from-green-900/20 dark:to-green-900/10">
        <h3 class="text-lg font-bold mb-4">Related Research</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Other articles in Project NIRV's knowledge graph with semantic relationships.
        </p>
        <div class="space-y-4">
          {relatedArticles.map((rel) => (
            <div class="p-4 bg-white dark:bg-gray-900 rounded-lg border border-green-200/50 dark:border-green-800/50">
              <div class="flex items-start justify-between gap-3 mb-2">
                <Link
                  href={`/blog/${rel.articleId}`}
                  class="font-semibold text-green-600 dark:text-green-400 hover:underline flex-1"
                >
                  {rel.articleId}
                </Link>
                <span class="text-xs text-white bg-green-600 dark:bg-green-700 px-2 py-1 rounded whitespace-nowrap shrink-0">
                  {rel.relationship.replace('-', ' ')}
                </span>
              </div>
              <p class="text-sm text-gray-700 dark:text-gray-300">{rel.reason}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Forecast Continuations -->
  {
    forecastContinuations.length > 0 && (
      <section class="rounded-lg border border-gray-200 dark:border-gray-700 p-6 bg-gradient-to-br from-purple-50 to-purple-50/50 dark:from-purple-900/20 dark:to-purple-900/10">
        <h3 class="text-lg font-bold mb-4">Future Research Directions</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Follow-up research topics identified by this analysis.
        </p>
        <div class="space-y-4">
          {forecastContinuations.map((continuation) => (
            <div class="p-4 bg-white dark:bg-gray-900 rounded-lg border border-purple-200/50 dark:border-purple-800/50">
              <p class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{continuation.topic}</p>
              <p class="text-sm text-gray-700 dark:text-gray-300 italic">{continuation.rationale}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Knowledge Graph Metadata -->
  {
    (canonicalTopics.length > 0 ||
      relatedConcepts.length > 0 ||
      relatedArticles.length > 0 ||
      forecastContinuations.length > 0) && (
      <section class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 bg-gray-50 dark:bg-gray-900 text-xs text-gray-600 dark:text-gray-400">
        <p class="font-medium mb-2">Machine-Readable Metadata</p>
        <p>
          This article is part of Project NIRV's interconnected semantic research graph. All canonical topics, related
          concepts, and article relationships are exposed through structured data (JSON-LD DefinedTerm and Schema.org
          schemas) for improved AI understanding and knowledge retrieval.
        </p>
      </section>
    )
  }
</aside>

---
import type { CollectionEntry } from 'astro:content'
import { getCombinedReadingTime, getSubpostCount, isSubpost } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
interface Props { entry: CollectionEntry<'blog'> }
const { entry } = Astro.props
const readTime = await getCombinedReadingTime(entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
const tags = entry.data.tags ?? []
---
<article class="research-entry">
  <a href={`/${entry.collection}/${entry.id}`}>
    <div>
      <div class="entry-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time><span>{readTime}</span>{subpostCount > 0 && <span>{subpostCount} connected {subpostCount === 1 ? 'part' : 'parts'}</span>}</div>
      <h3>{entry.data.title}</h3>
      {entry.data.description && <p>{entry.data.description}</p>}
      {tags.length > 0 && <div class="entry-meta" style="margin-top:17px">{tags.slice(0,3).map(tag => <span>{tag}</span>)}</div>}
    </div>
    <span class="entry-arrow" aria-hidden="true">↗</span>
  </a>
</article>

---
import AuthorCard from '@/components/AuthorCard.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllAuthors } from '@/lib/data-utils'

const authors = await getAllAuthors()
---

<Layout>
  <PageHead slot="head" title="Authors" />
  <header class="page-intro"><div><span class="section-index">07 / PEOPLE</span><h1>Authors</h1></div><p class="page-note">The people behind NIRV research.</p></header>
  {
    authors.length > 0 ? (
      <ul class="author-list">
        {authors.map((author) => (
          <li>
            <AuthorCard author={author} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted-foreground text-center">No authors found.</p>
    )
  }
</Layout>

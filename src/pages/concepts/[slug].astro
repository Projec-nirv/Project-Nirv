---
import Layout from '@/layouts/Layout.astro'
import PlotterFigure from '@/components/PlotterFigure.astro'
import { CANONICAL_CONCEPTS, getConceptHierarchy } from '@/lib/canonical-concepts'
import { generateConceptDefinedTermSchema, generateConceptBreadcrumbSchema } from '@/lib/semantic-knowledge-graph'
import { SITE } from '@/consts'
export async function getStaticPaths() { return Object.values(CANONICAL_CONCEPTS).map(concept => ({ params: { slug: concept.slug }, props: { concept } })) }
interface Props { concept: (typeof CANONICAL_CONCEPTS)[keyof typeof CANONICAL_CONCEPTS] }
const { concept } = Astro.props
const hierarchy = getConceptHierarchy(concept.id)
const definedTermSchema = generateConceptDefinedTermSchema(concept.id, SITE.href)
const breadcrumbSchema = generateConceptBreadcrumbSchema(concept.id, SITE.href)
const related = concept.relatedConcepts.map(id => CANONICAL_CONCEPTS[id]).filter(Boolean)
---
<Layout>
  <fragment slot="head"><title>{concept.label} | Project NIRV</title><meta name="description" content={concept.shortDescription} /><meta name="keywords" content={concept.keywords.join(', ')} /><script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} is:inline /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline /></fragment>
  <header class="page-intro"><div><a href="/concepts" class="section-index">← / CONCEPTS</a><h1>{concept.label}</h1></div><p class="page-note">{concept.shortDescription}</p></header>
  <div class="concept-detail"><aside class="technical-label">NIRV / DEFINED TERM<br />{concept.id}</aside><div><PlotterFigure compact caption="FIG. / CONNECTED SYSTEMS" /><section class="concept-section"><span class="eyebrow">01 / DEFINITION</span><p class="concept-description">{concept.description}</p></section>
    {concept.researchThemes.length > 0 && <section class="concept-section"><h2>Research themes</h2><ul class="line-list">{concept.researchThemes.map(theme => <li>{theme}</li>)}</ul></section>}
    {concept.canonicalArticles.length > 0 && <section class="concept-section"><h2>Primary research</h2><ul class="line-list">{concept.canonicalArticles.map(id => <li><a href={`/blog/${id}`}>{id.replaceAll('-', ' ')} ↗</a></li>)}</ul></section>}
    {concept.relatedArticles.length > 0 && <section class="concept-section"><h2>Related research</h2><ul class="line-list">{concept.relatedArticles.map(id => <li><a href={`/blog/${id}`}>{id.replaceAll('-', ' ')} ↗</a></li>)}</ul></section>}
    {(hierarchy.parents.length > 0 || hierarchy.children.length > 0 || related.length > 0) && <section class="concept-section"><h2>Connected concepts</h2><ul class="line-list">{[...hierarchy.parents,...hierarchy.children,...related].filter((item,index,array)=>array.findIndex(other=>other.slug===item.slug)===index).map(item => <li><a href={`/concepts/${item.slug}`}>{item.label} ↗</a><span>{item.shortDescription}</span></li>)}</ul></section>}
    {concept.aliases.length > 0 && <section class="concept-section"><h2>Also known as</h2><p>{concept.aliases.join(' · ')}</p></section>}
    {concept.keywords.length > 0 && <section class="concept-section"><h2>Key terms</h2><p>{concept.keywords.join(' · ')}</p></section>}
    <section class="concept-section concept-data"><span>Semantic density {concept.semanticDensity}/100</span><span>Retrieval importance {concept.retrievalImportance}/100</span></section>
  </div></div>
</Layout>
<style>.concept-detail{display:grid;grid-template-columns:1fr minmax(0,850px);gap:6vw;padding:70px 0}.concept-detail aside{line-height:2;color:var(--muted-ink)}.concept-section{padding:0 0 50px;margin-bottom:50px;border-bottom:1px solid var(--rule)}.concept-section h2{font:normal clamp(2rem,4vw,3.4rem) var(--serif);letter-spacing:-.045em;margin:0 0 24px}.concept-description{font:normal clamp(1.7rem,3vw,2.7rem)/1.35 var(--serif);letter-spacing:-.025em;margin:20px 0 0}.line-list{list-style:none;margin:0;padding:0}.line-list li{padding:16px 0;border-top:1px solid var(--rule);font:1rem/1.55 var(--sans)}.line-list a{text-decoration:none}.line-list a:hover{color:var(--accent)}.line-list li span{display:block;font:13px/1.6 var(--sans);color:var(--muted-ink);margin-top:6px}.concept-data{display:flex;justify-content:space-between;gap:20px;font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-ink)}@media(max-width:750px){.concept-detail{grid-template-columns:1fr;padding:45px 0}.concept-detail aside{display:none}}</style>

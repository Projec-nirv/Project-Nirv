---
import Layout from '@/layouts/Layout.astro'
import { listAllConcepts } from '@/lib/canonical-concepts'
import { generateResearchOrganizationSchema } from '@/lib/semantic-knowledge-graph'
const concepts = listAllConcepts()
const orgSchema = generateResearchOrganizationSchema()
---
<Layout>
  <fragment slot="head"><title>Concepts | Project NIRV</title><meta name="description" content="Explore Project NIRV's structured research concepts and their relationships." /><script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline /></fragment>
  <header class="page-intro"><div><span class="section-index">05 / KNOWLEDGE SYSTEM</span><h1>Concepts</h1></div><p class="page-note">The connected ideas that organize NIRV research.</p></header>
  <div class="concept-index"><aside class="technical-label">NIRV / CONCEPTS<br />{concepts.length.toString().padStart(2,'0')} ENTRIES</aside><ul class="research-list">{concepts.map((concept, index) => <li class="research-entry"><a href={`/concepts/${concept.slug}`}><div><span class="entry-meta">{String(index+1).padStart(2,'0')} / CONCEPT</span><h3>{concept.label}</h3><p>{concept.shortDescription}</p></div><span class="entry-arrow" aria-hidden="true">↗</span></a></li>)}</ul></div>
</Layout>
<style>.concept-index{display:grid;grid-template-columns:1fr minmax(0,900px);gap:6vw;padding-top:65px}.concept-index aside{line-height:2;color:var(--muted-ink)}@media(max-width:750px){.concept-index{grid-template-columns:1fr}.concept-index aside{display:none}}</style>

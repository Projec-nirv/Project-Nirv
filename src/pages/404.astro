---
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/Layout.astro'
import { cn } from '@/lib/utils'
---

<Layout>
  <PageHead slot="head" title="404" />
  <header class="page-intro"><div><span class="section-index">ERROR / 404</span><h1>Not found</h1></div><p class="page-note">The page you requested is not here.</p></header>

  <section
    class="flex flex-col items-center justify-center gap-y-4 text-center"
  >
    <div class="max-w-md">
      <p class="prose">Return to NIRV or explore current research.</p>
    </div>
    <Link
      href="/"
      class={cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span
      > Go to home page
    </Link>
  </section>
</Layout>

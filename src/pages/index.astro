---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import ShanShuiHero from '@/components/ShanShuiHero.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { SITE } from '@/consts'
const posts = await getRecentPosts(SITE.featuredPostCount)
---
<Layout>
  <PageHead slot="head" title="Home" />
  <section class="home-hero" aria-label="Procedural landscape">
    <ShanShuiHero caption="FIG. 01 / SYSTEMS IN MOTION" initialSeed="nirv-alpha-01" />
  </section>
  <section class="home-directions" aria-label="Areas of work">
    <a href="/blog" class="direction"><span class="section-index">02 / RESEARCH</span><div class="direction-art contour-art" aria-hidden="true"></div><div><h2>Research</h2><p>Things I've been looking into.</p></div><span class="direction-arrow" aria-hidden="true">↗</span></a>
    <a href="/vectorium" class="direction"><span class="section-index">03 / VECTORIUM</span><div class="direction-art vector-art" aria-hidden="true"></div><div><h2>Vectorium</h2><p>Things I'm building.</p></div><span class="direction-arrow" aria-hidden="true">↗</span></a>
  </section>
  {posts.length > 0 && <section class="home-latest" aria-labelledby="latest-title"><div class="latest-heading"><span class="section-index">04 / CURRENT WORK</span><h2 id="latest-title">Recent work.</h2><a href="/blog" class="text-action">All research ↗</a></div><ul class="research-list">{posts.map(post => <li><BlogCard entry={post} /></li>)}</ul></section>}
</Layout>
<style>
.home-hero{border-bottom:1px solid var(--rule)}.home-directions{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--rule)}.direction{position:relative;min-height:310px;padding:27px 50px 40px 0;display:grid;grid-template-columns:43% 1fr;grid-template-rows:auto 1fr;gap:25px;text-decoration:none}.direction+.direction{border-left:1px solid var(--rule);padding-left:45px}.direction .section-index{grid-column:1/-1}.direction-art{height:170px;border:1px solid var(--rule);align-self:start}.contour-art{background:repeating-radial-gradient(ellipse at 32% 55%,transparent 0 7px,#3b3e3855 8px 8.7px,transparent 9px 15px)}.vector-art{background:repeating-radial-gradient(ellipse at 50% 50%,transparent 0 10px,#3b3e3844 11px 11.7px,transparent 12px 20px);transform:skew(-12deg) scale(.9);border:0}.direction h2{font:normal clamp(1.8rem,2.8vw,3rem)/1.05 var(--serif);letter-spacing:-.045em;margin:0 0 15px}.direction p{font:13px/1.6 var(--mono);color:var(--muted-ink);max-width:280px}.direction-arrow{position:absolute;right:15px;top:28px;font:22px var(--serif)}.direction:hover h2,.direction:hover .direction-arrow{color:var(--accent)}.home-latest{padding-top:85px}.latest-heading{display:flex;align-items:end;gap:35px;margin-bottom:20px}.latest-heading h2{font:normal clamp(2.5rem,4vw,4rem) var(--serif);letter-spacing:-.05em;margin:0}.latest-heading .text-action{margin:0 0 12px auto}@media(max-width:800px){.home-directions{grid-template-columns:1fr}.direction+.direction{border-left:0;border-top:1px solid var(--rule);padding-left:0}.direction{min-height:245px}.latest-heading{display:block}.latest-heading .text-action{margin:10px 0 0}}@media(max-width:520px){.direction{grid-template-columns:1fr;gap:20px;padding-right:0}.direction-art{height:125px}.latest-heading h2{margin-top:12px}}
</style>

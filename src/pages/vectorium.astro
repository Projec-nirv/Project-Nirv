---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import PlotterFigure from '@/components/PlotterFigure.astro'
import { getEntry, render } from 'astro:content'
import { SITE } from '@/consts'

const vectoriumContent = await getEntry('vectorium', 'vectorium')
const { Content } = vectoriumContent ? await render(vectoriumContent) : { Content: null }

const title = "Vectorium - Experimental Systems & Applied Research"
const description = "Vectorium is the applied research ecosystem of Project NIRV—a dedicated space for experimental systems, intelligence platforms, and research-driven products emerging from rigorous analysis."

// Generate JSON-LD schemas for Vectorium
const vectoriumSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': new URL('/vectorium', Astro.site).toString(),
  name: title,
  description: description,
  url: new URL('/vectorium', Astro.site).toString(),
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE.href}/#website`,
    name: SITE.title,
  },
  about: {
    '@type': 'Thing',
    name: 'Experimental Systems Research',
    description: 'Applied research infrastructure and experimental systems'
  },
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE.href}/#organization`,
    name: 'Project NIRV',
    description: 'Research-driven initiative for systems intelligence',
    url: SITE.href
  },
  hasPart: [
    {
      '@type': 'SoftwareApplication',
      '@id': new URL('/vectorium/trace', Astro.site).toString(),
      name: 'Trace',
      description: 'Attribution intelligence and verification system',
      url: new URL('/vectorium/trace', Astro.site).toString(),
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      isPartOf: {
        '@type': 'WebSite',
        '@id': new URL('/vectorium', Astro.site).toString(),
        name: 'Vectorium'
      }
    }
  ]
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Vectorium',
      item: new URL('/vectorium', Astro.site).toString()
    }
  ]
}
---

<Layout>
  <PageHead slot="head" title={title} description={description} />
  <script type="application/ld+json" set:html={JSON.stringify(vectoriumSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  
  <header class="page-intro"><div><span class="section-index">03 / APPLIED RESEARCH</span><h1>Vectorium</h1></div><p class="page-note">Where NIRV research becomes experimental systems and operational infrastructure.</p></header>
  <PlotterFigure caption="FIG. 02 / EXPERIMENTAL SYSTEMS" />
  <section class="content-sheet"><span class="side-label">NIRV / SYSTEMS<br />& EXPERIMENTS</span><div class="prose">{Content && <Content />}</div></section>
</Layout>

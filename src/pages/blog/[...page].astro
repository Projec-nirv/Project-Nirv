---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'
import PaginationComponent from '@/components/ui/pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts, groupPostsByYear } from '@/lib/data-utils'
import type { PaginateFunction } from 'astro'
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) { return paginate(await getAllPosts(), { pageSize: SITE.postsPerPage }) }
const { page } = Astro.props
const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a,b) => parseInt(b)-parseInt(a))
---
<Layout>
  <PageHead slot="head" title="Research" />
  <header class="page-intro"><div><span class="section-index">02 / RESEARCH</span><h1>Research</h1></div><p class="page-note">Strategic signals in infrastructure and systems change. Analysis of structural economics, platform dynamics, resource constraints and macroeconomic fragility.</p></header>
  <div class="listing-layout"><aside class="technical-label">NIRV / WORKS<br />{page.currentPage.toString().padStart(2,'0')} — {page.lastPage.toString().padStart(2,'0')}</aside><div>{years.length > 0 ? years.map(year => <section aria-label={`Research from ${year}`}><h2 class="research-year">{year}</h2><ul class="research-list">{postsByYear[year].map(post => <li><BlogCard entry={post} /></li>)}</ul></section>) : <p>No research entries yet.</p>}<PaginationComponent currentPage={page.currentPage} totalPages={page.lastPage} baseUrl="/blog/" client:load /></div></div>
</Layout>
<style>.listing-layout{width:min(100%,1100px);margin-inline:auto}.listing-layout aside{padding-top:48px;line-height:1.9;color:var(--muted-ink)}.listing-layout>div{padding-bottom:60px}.listing-layout>div>section:first-child .research-year{margin-top:24px}@media(max-width:750px){.listing-layout aside{display:none}.listing-layout>div>section:first-child .research-year{margin-top:42px}}</style>

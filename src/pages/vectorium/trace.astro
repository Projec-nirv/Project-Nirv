---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getEntry, render } from 'astro:content'
import { SITE } from '@/consts'

const traceContent = await getEntry('vectorium', 'trace')
const { Content } = traceContent ? await render(traceContent) : { Content: null }

const title = "Trace - Attribution Intelligence System"
const description = "Trace is an attribution intelligence and verification system designed to analyze inconsistencies between ecommerce revenue signals and advertising platform attribution across Shopify, Meta Ads, Instagram Ads, and Google Ads."

// Generate JSON-LD schemas for Trace
const traceSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': new URL('/vectorium/trace', Astro.site).toString(),
  name: 'Trace',
  description: description,
  url: new URL('/vectorium/trace', Astro.site).toString(),
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  keywords: ['attribution', 'verification', 'ecommerce', 'advertising', 'analytics', 'signal integrity'],
  abstract: 'An attribution intelligence platform that analyzes inconsistencies between revenue signals and advertising platform attribution data across multiple platforms.',
  about: [
    {
      '@type': 'Thing',
      name: 'Attribution Verification'
    },
    {
      '@type': 'Thing',
      name: 'Advertising Analytics'
    },
    {
      '@type': 'Thing',
      name: 'Cross-Platform Signal Analysis'
    }
  ],
  isPartOf: {
    '@type': 'WebSite',
    '@id': new URL('/vectorium', Astro.site).toString(),
    name: 'Vectorium',
    url: new URL('/vectorium', Astro.site).toString()
  },
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE.href}/#organization`,
    name: 'Project NIRV',
    url: SITE.href
  },
  codeRepository: 'https://github.com/Reuxbite/Trace',
  author: {
    '@type': 'Organization',
    name: 'Project NIRV',
    url: SITE.href
  },
  featureList: [
    'Cross-platform signal reconciliation',
    'Revenue and advertising data reconciliation',
    'Consistency analysis across platforms',
    'Structured anomaly detection',
    'Operational visibility and verification'
  ]
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Vectorium',
      item: new URL('/vectorium', Astro.site).toString()
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Trace',
      item: new URL('/vectorium/trace', Astro.site).toString()
    }
  ]
}
---

<Layout>
  <PageHead slot="head" title={title} description={description} />
  <script type="application/ld+json" set:html={JSON.stringify(traceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  
  <header class="page-intro"><div><a href="/vectorium" class="section-index">← / VECTORIUM</a><h1>Trace</h1></div><p class="page-note">Attribution intelligence and verification across revenue and advertising signals.</p></header>
  <section class="content-sheet"><span class="side-label">VECTORIUM / 01<br />EXPERIMENTAL SYSTEM</span><div class="prose">{Content && <Content />}<p>Trace is part of <a href="/vectorium">Vectorium</a>, the applied research ecosystem of Project NIRV.</p><p>Repository: <a href="https://github.com/Reuxbite/Trace">github.com/Reuxbite/Trace</a></p></div></section>
</Layout>

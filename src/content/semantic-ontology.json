    "conceptualRelationships": {
      "cloudCostGravity": {
        "name": "Cloud Cost Gravity",
        "definition": "Structural economic phenomenon where infrastructure expenses grow faster than revenue as startups scale",
        "relatedConcepts": [
          "unit economics",
          "organizational misalignment",
          "technical debt",
          "cost management",
          "scaling challenges"
        ],
        "implications": [
          "Infrastructure costs eventually constrain profitability",
          "Architectural decisions early on create permanent cost drag",
          "Cost reduction requires organizational transformation"
        ],
        "oppositeOf": "Economies of Scale (traditional)",
        "examples": [
          "AWS cost growth outpacing SaaS revenue growth",
          "Microservices creating baseline infrastructure overhead"
        ]
      },
      "demandGravity": {
        "name": "Demand Gravity",
        "definition": "Structural phenomenon where user demand normalizes after emergency conditions, creating unsustainable unit economics",
        "relatedConcepts": [
          "demand seasonality",
          "pandemic-driven adoption",
          "willingness-to-pay",
          "customer churn",
          "market saturation"
        ],
        "implications": [
          "Emergency demand is not structural demand",
          "Customer acquisition costs remain elevated even at scale",
          "Preference reversals can occur when choice returns"
        ],
        "oppositeOf": "Secular Growth",
        "examples": [
          "EdTech demand collapse post-pandemic",
          "Online education preference decline"
        ]
      },
      "coldStartProblem": {
        "name": "Cold-Start Problem",
        "definition": "Challenge faced by two-sided platforms in acquiring initial critical mass on both demand and supply sides",
        "relatedConcepts": [
          "chicken-and-egg problem",
          "network effects",
          "bootstrap phase",
          "initial growth dynamics",
          "platform seeding"
        ],
        "implications": [
          "Early platform growth requires strategic subsidization",
          "Timing and sequencing of supply/demand acquisition is critical",
          "Bootstrap success determines long-term viability"
        ],
        "relatedArticles": [
          "The Chicken-and-Egg Problem"
        ]
      },
      "waterConstraint": {
        "name": "Water as Growth Constraint",
        "definition": "Structural constraint where water availability directly limits economic growth in resource-dependent economies",
        "relatedConcepts": [
          "resource constraints",
          "infrastructure constraints",
          "agricultural dependency",
          "groundwater depletion",
          "environmental economics"
        ],
        "implications": [
          "Water scarcity imposes ceiling on agricultural GDP",
          "Urbanization and industrialization face physical limits",
          "Infrastructure inefficiency amplifies resource constraints"
